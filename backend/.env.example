# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas: mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/quizpilot

# JWT Secret for Session Authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
# Powered by official @google/genai SDK (models: gemini-2.5-flash, gemini-1.5-flash)
# If omitted or invalid, QuizPilot automatically engages the verified Board Question Bank fallback
GEMINI_API_KEY=
